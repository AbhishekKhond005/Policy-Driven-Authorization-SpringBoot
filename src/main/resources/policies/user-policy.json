{
  "rules": [
    {
      "name": "User Profile Access",
      "resource": "/api/profile/**",
      "actions": ["GET"],
      "conditions": [
        { "attribute": "resource_owner", "operator": "EQUALS", "value": "current_user", "type": "DYNAMIC" }
      ]
    },
    {
      "name": "User Profile Edit",
      "resource": "/api/profile/**",
      "actions": ["PUT"],
      "conditions": [
        { "attribute": "resource_owner", "operator": "EQUALS", "value": "current_user", "type": "DYNAMIC" }
      ]
    },
    {
      "name": "Public Endpoints",
      "resource": "/api/public/**",
      "actions": ["GET"],
      "conditions": []
    }
  ]
}
